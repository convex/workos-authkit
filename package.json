{
  "name": "@convex-dev/workos-authkit",
  "description": "A WorkOS AuthKit component for Convex.",
  "repository": "github:convex/workos-authkit",
  "homepage": "https://github.com/convex/workos-authkit#readme",
  "bugs": {
    "url": "https://github.com/convex/workos-authkit/issues"
  },
  "version": "0.3.0",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "prepack": "npm run build",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run --typecheck",
    "check": "npm run test && npm run typecheck && npm run lint",
    "test:e2e": "convex init && npm run build:codegen && convex dev --once --typecheck-components",
    "format": "prettier --write .",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "@workos-inc/authkit-react": "^0.13.0 || ^0.16.0",
    "@workos-inc/node": "^7.75.1 || ^8.0.0 || ^9.0.0 || ^10.0.0",
    "convex": "^1.29.3",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@convex-dev/eslint-plugin": "5.0.1",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "chokidar-cli": "3.0.0",
    "convex": "1.49.0",
    "convex-test": "0.0.69",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "pkg-pr-new": "0.0.93",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "dependencies": {
    "@convex-dev/workflow": "^0.4.0",
    "@convex-dev/workos": "^0.0.3",
    "@convex-dev/workpool": "^0.4.4",
    "convex-helpers": "^0.1.128",
    "type-fest": "^5.1.0"
  }
}
